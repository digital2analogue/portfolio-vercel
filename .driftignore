# Files exempt from design-system drift scanning, with reasons.
# Honored by brand-tokens scripts/drift-lint.mjs (and its CI workflow).
# Everything not listed here is held to the shared rules in
# brand-tokens/scripts/rules.mjs.

# The inlined token block is a sanctioned copy of the source of truth — raw hex
# primitives live here by design. See CLAUDE.md "Design Token System".
app/globals.css

# The /tokens viewer renders hex values as displayed data, not as styling.
app/tokens/page.tsx

# Next.js viewport themeColor must be a literal hex; CSS vars aren't allowed there.
app/layout.tsx

# The JS token bridge is the single sanctioned adapter allowed to reference
# --primitive-font-family-* (no semantic family-only token exists yet).
# See brand-tokens docs/decisions.md (2026-06-05 font-family decision).
lib/tokens.ts

# The OTKit case-study demos are faithful reproductions of another company's
# design system, rendered inside the dark site. Their palette is demo-local
# by design (see CLAUDE.md "Interactive Case Demos") — these hex values are
# OTKit's, and must never leak into (or be replaced by) Parsimony tokens.
lib/reservationStates.ts
lib/tableStatus.ts

# Case-study body content — hex appears only in prose/alt-text describing
# token-resolution diagrams, not as styling.
lib/caseContent.ts

# The /work/system lint playground ships its own sample snippets as strings:
# SAMPLE_VIOLATIONS is deliberately-bad CSS the demo detects and highlights, and
# SAMPLE_CLEAN references a deprecated token on purpose so the "before" state
# has something to fix. They are rendered text, not styling — correctly flagged
# by the shared rules, correctly exempt here. (parsimony#174)
lib/checkUsageRules.ts

# The "One component, two brands" demo dataset (components/demos/BrandThemeDemo).
# Same class as the OTKit files above: these are OTKit's own brand-collection
# values, read from the declared vector fills in the portfolio deck, and they are
# namespaced `otkit/` precisely to hold them apart from Parsimony's `--color-*`.
# Replacing them with Parsimony tokens would destroy what the demo demonstrates.
lib/brandThemes.ts

# Deployed prototypes: self-contained static HTML served in an `embed` block,
# each shipping its own complete stylesheet. The iPad FoH prototype is the
# owner's Claude Design export, and its tokens match the OTKit Figma source
# exactly (CLAUDE.md, 2026-08-10) — it is documented as living outside the
# contrast gate and the cascade guard for the same reason it lives outside the
# rules here: an iframe is not same-document DOM, and none of this is Parsimony
# component code. Directory-wide because that is what the directory is FOR; if
# a Parsimony-governed source file is ever added here, narrow this to the file.
public/projects/prototypes/**
